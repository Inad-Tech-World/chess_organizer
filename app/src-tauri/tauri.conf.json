{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Organiser",
  "version": "0.1.0",
  "identifier": "org.chessorganiser.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chess Organiser",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; frame-src 'self' about:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Free chess tournament manager",
    "longDescription": "Run Swiss, round-robin and team chess tournaments: registration, pairings, results, standings and FIDE rating reports.",
    "copyright": "Copyright (C) 2026 Chess Organiser contributors. GPL-3.0-or-later.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["cot"],
        "name": "Chess Organiser tournament",
        "description": "Chess Organiser tournament file",
        "role": "Editor",
        "mimeType": "application/x-chess-organiser-tournament"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
